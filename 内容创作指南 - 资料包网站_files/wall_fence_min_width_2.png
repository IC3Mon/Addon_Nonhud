    <div class="site-header-stack">
    
<aside class="maintenance-banner maintenance-banner--bug" data-maintenance-banner data-maintenance-kind="bug" data-maintenance-immediate="1" data-maintenance-revision="8-1790181764.087163" role="status" aria-live="polite">
    <div class="maintenance-banner-inner">
        <span class="maintenance-banner-icon" aria-hidden="true"><i class="fas fa-bug"></i></span>
        <div class="maintenance-banner-copy">
            <span class="maintenance-banner-kind">Bug alert</span>
            <strong>Slowdowns</strong>
            <span data-maintenance-status>We are aware of an issue and are working on a fix.</span>
            <span class="maintenance-banner-message">The server is overloaded and experiencing slowdowns due to too many current active users.</span>
        </div>
        <button type="button" class="maintenance-banner-close" data-maintenance-dismiss aria-label="Dismiss warning" title="Dismiss"><i class="fas fa-times" aria-hidden="true"></i></button>
    </div>
</aside>
<script>
(function(){
    const banner=document.querySelector('[data-maintenance-banner]');
    if(!banner)return;
    const key='non-maintenance-dismissed:'+banner.dataset.maintenanceRevision;
    try{if(localStorage.getItem(key)==='1'){banner.remove();return;}}catch(_){}
    const status=banner.querySelector('[data-maintenance-status]');
    const remove=()=>{banner.classList.add('is-closing');setTimeout(()=>banner.remove(),260);};
    let timer=null;
    banner.querySelector('[data-maintenance-dismiss]').addEventListener('click',()=>{try{localStorage.setItem(key,'1');}catch(_){}if(timer)clearInterval(timer);remove();});
    // Bug alerts and host updates are static: they have no schedule and stay
    // up until an administrator ends them.
    if(banner.dataset.maintenanceImmediate==='1')return;
    const kind=banner.dataset.maintenanceKind||'maintenance';
    const phrases={
        maintenance:{scheduled:'Maintenance starts',underway:'Maintenance is currently underway.'},
        update:{scheduled:'A site update starts',underway:'A site update is currently underway.'},
    }[kind]||{scheduled:'Maintenance starts',underway:'Maintenance is currently underway.'};
    const start=new Date(banner.dataset.maintenanceStart);
    const end=new Date(banner.dataset.maintenanceEnd);
    const timeFormatter=new Intl.DateTimeFormat(undefined,{hour:'2-digit',minute:'2-digit',hour12:true});
    const dateFormatter=new Intl.DateTimeFormat(undefined,{month:'short',day:'numeric'});
    const sameLocalDay=(left,right)=>left.getFullYear()===right.getFullYear()&&left.getMonth()===right.getMonth()&&left.getDate()===right.getDate();
    const scheduledText=now=>{
        const time=timeFormatter.format(start);
        if(sameLocalDay(start,now))return `${phrases.scheduled} today (${dateFormatter.format(start)}) at ${time}.`;
        const tomorrow=new Date(now.getFullYear(),now.getMonth(),now.getDate()+1);
        if(sameLocalDay(start,tomorrow))return `${phrases.scheduled} tomorrow (${dateFormatter.format(start)}) at ${time}.`;
        return `${phrases.scheduled} ${dateFormatter.format(start)} at ${time}.`;
    };
    const update=()=>{const now=new Date();if(now>=end){remove();return false;}status.textContent=now>=start?phrases.underway:scheduledText(now);return true;};
    update();
    timer=setInterval(()=>{if(!update()){clearInterval(timer);timer=null;}},30000);
})();
</script>


